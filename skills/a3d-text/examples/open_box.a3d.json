{
  "schema": "a3d-design/v1",
  "units": {"length": "mm", "angle": "deg"},
  "params": {
    "width": {"type": "length", "value": 80, "range": [70, 90], "label": {"en": "Overall width", "zh": "整体宽度"}},
    "depth": {"type": "length", "value": 60, "range": [50, 70], "label": {"en": "Overall depth", "zh": "整体深度"}},
    "height": {"type": "length", "value": 30, "range": [25, 35], "label": {"en": "Overall height", "zh": "整体高度"}},
    "wall": {"type": "length", "value": 2, "range": [1.5, 3], "label": {"en": "Wall thickness", "zh": "壁厚"}},
    "floor": {"type": "length", "value": 2, "range": [1.5, 3], "label": {"en": "Floor thickness", "zh": "底板厚度"}}
  },
  "parts": {
    "body": {
      "features": [
        {
          "id": "shell", "op": "open_box",
          "size": ["=width", "=depth", "=height"],
          "wall": "=wall", "floor": "=floor"
        }
      ],
      "result": "@body.shell"
    }
  }
}
